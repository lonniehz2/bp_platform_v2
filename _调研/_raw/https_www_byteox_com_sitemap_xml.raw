    if (window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      bar.style.width = '100%'
      bar.style.transform = 'translateX(0)'
      return
    }

    if (typeof bar.animate === 'function') {
      bar.animate(
        [
          { transform: 'translateX(-120%)' },
          { transform: 'translateX(240%)' }
        ],
        {
          duration: 920,
          iterations: Infinity,
          easing: 'cubic-bezier(0.4, 0, 0.2, 1)'
        }
      )
    }
  }

  if (document.body) {
    createLoader()
  } else {
    document.addEventListener('DOMContentLoaded', createLoader, { once: true })
  }
})()
</script><!--teleport start anchor--><!----><!--teleport anchor--><!--teleport start anchor--><!----><!--teleport anchor--><div id="__nuxt"><div class="n-config-provider"><div class="layout"><!--[--><header class="header-container" style="background:rgba(255, 255, 255, 1);" data-v-b2ff7d4d><div class="nav-inner w-1200px flex justify-between mx-auto" data-v-b2ff7d4d><nav class="flex items-center justify-start" data-v-b2ff7d4d><div class="nav-logo" data-v-b2ff7d4d><img class="w-322px h-28px" alt="字节牛, 寓盟管家，推房助手" src="/images/nav/byteox-icon.png" data-v-b2ff7d4d><a aria-current="page" href="/" class="router-link-active router-link-exact-active absolute left-0 top-0 w-115px h-60px z-10" data-v-b2ff7d4d></a><a href="/product/product" class="absolute left-130px top-0 w-90px h-60px z-10" data-v-b2ff7d4d></a><a href="/product/tfzs" class="absolute top-0 right-0 w-90px h-60px z-10" data-v-b2ff7d4d></a></div><div class="h-60px leading-60px px-14px cursor-pointer nav-item group" data-v-b2ff7d4d><div class="" data-v-b2ff7d4d><span class="mr-1 text-current" data-v-b2ff7d4d>产品</span><span class="nav-icon-pointer icon-font group-hover:rotate-180 group-hover:transform group-hover:transition-transform group-hover:duration-500" data-v-b2ff7d4d></span></div><div class="nav-drawer" data-v-b2ff7d4d><div class="nav-drawer-concent" data-v-b2ff7d4d><div class="flex w-full min-h-365px flex justify-center" data-v-b2ff7d4d><div class="flex justify-between w-1200px" data-v-b2ff7d4d><div class="nav-select text-hex-111 text-size-14px leading-20px py-36px" data-v-b2ff7d4d><!--[--><div class="bg-hex-F0F5FF text-hex-0A87F8 w-172px h-44px pl-15px mr-10px leading-42px rounded-8px font-bold" data-v-b2ff7d4d>寓盟管家</div><div class="w-172px h-44px pl-15px mr-10px leading-42px rounded-8px font-bold" data-v-b2ff7d4d>推房助手</div><div class="w-172px h-44px pl-15px mr-10px leading-42px rounded-8px font-bold" data-v-b2ff7d4d>萌友租房</div><div class="w-172px h-44px pl-15px mr-10px leading-42px rounded-8px font-bold"