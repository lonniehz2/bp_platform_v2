# 生产环境变量模板：复制到 /etc/bp-platform.env 并 chmod 600
SPRING_PROFILES_ACTIVE=prod
SERVER_PORT=8091
DB_URL=jdbc:mysql://127.0.0.1:3306/bp_platform_v2?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true&useSSL=false
DB_USER=bp_platform
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD
AUTH_SECRET=CHANGE_ME_64_RANDOM_CHARS
CORS_ALLOWED_ORIGINS=https://bp.example.com
LOG_FILE=/opt/bp-platform/logs/bp-platform.log
FILE_ROOT=/opt/bp-platform/uploads
JAVA_OPTS=-Xms512m -Xmx1536m -Dfile.encoding=UTF-8
